    "@relay-protocol/settlement-sdk": "0.0.148",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-ethers": "1.8.24",
    "@zk-kit/lean-imt": "2.2.4",
    "@zk-kit/lean-imt.sol": "2.0.0",
    "ethers": "6.17.0",
    "maci-crypto": "2.5.0",
    "poseidon-solidity": "0.0.5",
    "snarkjs": "0.7.5",
    "solc": "0.8.28",
    "viem": "2.22.14"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
