{
  "name": "lincoln-relay",
  "version": "0.1.0",
  "description": "Lincoln privacy-pool relay for Robinhood Chain (4663): validates proofs, submits transactions, signs points receipts.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "plan": "node docker/mainnet/start.mjs plan docker/mainnet/runtime.example.json",
