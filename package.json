    "stage-release": "node docker/mainnet/stage-public-release.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@ethersproject/sha2": "5.8.0",
    "@openzeppelin/contracts": "5.0.2",
